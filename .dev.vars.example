# Copy to .dev.vars for local `pnpm run dev` (never commit .dev.vars).
# In production, set these via `wrangler secret put <NAME>`.

# Required: Ed25519 Nix secret keys generated by `firn keygen`
MAIN_SIGNING_KEY="cache.example.com-1:..."
PR_SIGNING_KEY="cache.example.com-pr-1:..."

# Optional: GitHub App private key PEM (PKCS#1 or PKCS#8) for local push and private package pull
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional: Classic PAT (read:packages + delete:packages) for GHCR GC deletion
# GITHUB_PACKAGES_TOKEN="ghp_..."

# Optional: GitHub webhook HMAC-SHA256 secret for POST /api/v1/webhooks/github
# GITHUB_WEBHOOK_SECRET=""

# Optional: JSON map of owner -> array of Bearer tokens for local `firn push --token`
# MANUAL_TOKENS_JSON='{"so1ve":["secret-token"]}'

# Optional: Bearer token for remote CLI admin commands (`firn status`, `firn ls`, `firn pr`, `firn gc`)
# ADMIN_TOKEN=""
