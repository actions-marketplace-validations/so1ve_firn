{
  "name": "firn",
  "private": true,
  "version": "1.2.2",
  "packageManager": "pnpm@12.23.0",
  "author": "Ray <i@mk1.io> (https://github.com/so1ve/)",
  "type": "module",
  "description": "Nix binary cache index for GHCR with PR overlays, closure-safe GC, and OIDC CI uploads",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/so1ve/firn.git"
  },
  "license": "MIT",
  "bin": {
    "firn": "./src/cli/index.ts"
  },
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "build:action": "tsdown",
    "cf-typegen": "wrangler types",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "wrangler dev",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write",
    "release": "bumpp",
    "serve": "node src/cli/index.ts serve",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerc/plugin-completions": "2.0.0-beta.1",
    "@hono/node-server": "^2.1.11",
    "@libsql/hrana-client": "^0.10.0",
    "clerc": "2.0.0-beta.1",
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "latest",
    "@so1ve/eslint-config": "^4.7.0",
    "@so1ve/prettier-config": "^4.7.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
